{
  "@if": {
    "prefix": "@if",
    "body": "@if($${1:condition})\n\t$0\n@endif",
    "description": "SFHT @if directive"
  },
  "@foreach": {
    "prefix": "@foreach",
    "body": "@foreach($${1:items} as $${2:item})\n\t{{ $$2 }}\n@endforeach",
    "description": "SFHT @foreach loop"
  },
  "@for": {
    "prefix": "@for",
    "body": "@for($i = 0; $i < ${1:count}; $i++)\n\t{{ $i }}\n@endfor",
    "description": "SFHT @for loop"
  },
  "@extends": {
    "prefix": "@extends",
    "body": "@extends('${1:layouts.base}')",
    "description": "SFHT template inheritance"
  },
  "@block": {
    "prefix": "@block",
    "body": "@block('${1:content}')\n\t$0\n@endblock",
    "description": "SFHT template block"
  },
  "@include": {
    "prefix": "@include",
    "body": "@include('${1:partial}')",
    "description": "SFHT include template"
  },
  "{{": {
    "prefix": "{{",
    "body": "{{ $${1:variable} }}",
    "description": "SFHT variable interpolation"
  },
  "@data": {
    "prefix": "@data",
    "body": "<div @data=\"{ ${1:count}: 0 }\">\n\t$0\n</div>",
    "description": "SFJS reactive component"
  }
}
